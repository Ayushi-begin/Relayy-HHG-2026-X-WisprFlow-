# Copy to .env and fill in real values. Never commit .env.

# --- LLM providers -----------------------------------------------------------------------------
# Agents run on whichever provider LLM_PROVIDER names. Without that provider's key AND explicit
# model IDs, each agent runs labeled simulated analysis that can never authorize provider effects.
# One of: gemini | anthropic | openai
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_FAST_MODEL=gemini-2.5-flash
GEMINI_SMART_MODEL=gemini-2.5-pro
ANTHROPIC_API_KEY=
ANTHROPIC_FAST_MODEL=claude-haiku-5-5
ANTHROPIC_SMART_MODEL=claude-opus-5-5
# Server-side refusal fallback on models that support it; the serving model is recorded. "off" disables.
ANTHROPIC_REFUSAL_FALLBACK=default
OPENAI_API_KEY=
# Set account-supported model IDs before using OpenAI.
OPENAI_FAST_MODEL=
OPENAI_SMART_MODEL=
# Optional per-agent override as provider:model, e.g. LLM_ROUTE_TRIAGE=anthropic:claude-haiku-5-5
LLM_ROUTE_TRIAGE=
LLM_ROUTE_RESEARCH=
LLM_ROUTE_ACTION=
# static: fixed tiers. adaptive: complex/flagged triage uses the smart tier, and an open circuit
# routes to LLM_FALLBACK_PROVIDER (only if set and configured).
LLM_ROUTING=static
LLM_FALLBACK_PROVIDER=
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
# Verified USD prices per million tokens: {"model-id": [input, output, cache_read, cache_write]}.
# Costs show as unavailable for any model not listed here.
LLM_PRICING_JSON=

# --- Slack -------------------------------------------------------------------------------------
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=xoxb-...
# Channel for escalations (e.g. C0123456789); the bot must be invited to it.
SLACK_CHANNEL_ID=
SLACK_ALLOWED_TEAM_ID=
SLACK_ALLOWED_REVIEWERS=

# --- Delivery (Resend email, Stripe refunds) ---------------------------------------------------
# Real effects stay disabled until test fixtures and recipient bindings are verified.
DELIVERY_MODE=disabled
RESEND_API_KEY=
RESEND_FROM=
RESEND_ALLOWED_RECIPIENTS=
STRIPE_SECRET_KEY=
STRIPE_ACCOUNT_ID=
STRIPE_API_VERSION=2025-02-24.acacia

# --- Operator access ---------------------------------------------------------------------------
DEMO_OPERATOR_TOKEN=
DEMO_OPERATOR_NAME=demo-operator
