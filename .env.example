# Copy to .env and fill in real values. Never commit .env.

# --- LLM: Google Gemini (free tier) ------------------------------------------------------------
# Get a free key at https://aistudio.google.com/apikey. Without a key AND model IDs, agents run
# labeled simulated analysis that can never authorize provider effects.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Triage uses the fast model; research and action use the smart model.
GEMINI_FAST_MODEL=gemini-2.5-flash
GEMINI_SMART_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2

# --- Database ----------------------------------------------------------------------------------
# Leave empty locally to use SQLite (backend/relayy.db). In production use Neon:
# DATABASE_URL = pooled string (host contains "-pooler"), MIGRATION_DATABASE_URL = direct string.
DATABASE_URL=
MIGRATION_DATABASE_URL=

# --- Web ---------------------------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API (your Vercel URL in production).
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=60
# Required for every mutation once set; use 32+ random characters in production.
DEMO_OPERATOR_TOKEN=
DEMO_OPERATOR_NAME=demo-operator

# --- Slack (optional) --------------------------------------------------------------------------
SLACK_WEBHOOK_URL=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
# Channel for escalations (e.g. C0123456789); the bot must be invited to it.
SLACK_CHANNEL_ID=
SLACK_ALLOWED_TEAM_ID=
SLACK_ALLOWED_REVIEWERS=

# --- Delivery: Resend email, Stripe refunds (optional) -----------------------------------------
# Real effects stay disabled until test fixtures and recipient bindings are verified.
DELIVERY_MODE=disabled
RESEND_API_KEY=
RESEND_FROM=
RESEND_ALLOWED_RECIPIENTS=
STRIPE_SECRET_KEY=
STRIPE_ACCOUNT_ID=
STRIPE_API_VERSION=2025-02-24.acacia
